  <key>LSUIElement</key>
  <true/>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.signflow.helper</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>signflow-edit</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
