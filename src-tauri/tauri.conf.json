{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignFlow Helper",
  "version": "0.1.3",
  "identifier": "com.signflow.helper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "SignFlow",
    "category": "Productivity",
    "shortDescription": "Opens SignFlow files in Flexi and saves them back",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["signflow-edit"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzODlCNUFFOUJENjIzRDkKUldUWkk5YWJycldKazlKK2N5VjIyREtkakNlSzV2dU8zLzJQeUdpY3FBbWtLTnB3TThDSk9TRFYK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
